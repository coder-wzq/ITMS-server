# ITMS Environment Variables Example
# Copy this file to .env and adjust values

# PostgreSQL
PG_DB=itms
PG_USER=itms
PG_PASSWORD=itms@2026

# Redis
REDIS_PASSWORD=itms@2026

# JWT (must be >= 32 characters)
JWT_SECRET=itms-jwt-secret-min-32-chars!!

# Etcd (comma-separated for cluster)
ETCD_ENDPOINTS=etcd:2379

# App
APP_ENV=development
APP_DEBUG=true
